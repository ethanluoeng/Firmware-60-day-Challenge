

#ifndef RINGBUFFER_H_
#define RINGBUFFER_H_
#include <stdint.h>

// Define structure of the ring buffer struct
typedef struct {
    uint8_t *buffer_array;
    volatile int head_index;
    volatile int tail_index;
    int capacity;
} ringBuffer;

void rb_init(ringBuffer *buffer, uint8_t *buffer_array, int capacity);
int rb_is_full(ringBuffer *buffer);
int rb_is_empty(ringBuffer *buffer);
int rb_write(ringBuffer *buffer, uint8_t data);
uint8_t rb_read(ringBuffer *buffer);
int rb_read_paste(ringBuffer *buffer, uint8_t *out_data);

#endif /* RINGBUFFER_H_ */
