void String_Parse_Compare(uint8_t *line_buf)
{
	char *tok = strtok((char *)line_buf, " ");

	if (tok != NULL && strcmp(tok, "led") == 0) {
	    char *arg = strtok(NULL, " ");
	    if (arg != NULL && strcmp(arg, "on") == 0) {
	    	// turn LED on
	    	BSP_LED_On(LED2);
	    } else if (arg != NULL && strcmp(arg, "off") == 0) {
	        // turn LED off
	    	BSP_LED_Off(LED2);
	    } else {
	        // TODO: send "ERR usage: led on|off"
	    }
	}
	else if (tok != NULL && strcmp(tok, "pwm") == 0) {
	    char *arg = strtok(NULL, " ");
	    if (arg != NULL) {
	        int val = atoi(arg);
	        if (val >= 0 && val <= 100) {
